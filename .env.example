# ==============================================================================
# Environment Configuration Template (.env.example)
# Duplicate this file as .env and configure values for your environment.
# ==============================================================================

# Application Settings
APP_NAME="Sistema de Gestión de Inventario"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/personal-finance
APP_KEY="your_generated_secret_key_here"

# Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_username
DB_PASS="your_db_password"
DB_NAME=personal_finance
DB_CHARSET=utf8mb4

# Business & Inventory Configuration
TAX_RATE=13
LOW_STOCK_THRESHOLD=3

# Security & Authentication Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900
SESSION_LIFETIME=1800

# System API Keys & External Services
SYSTEM_API_KEY="your_system_api_key_here"
PAYMENT_GATEWAY_API_KEY="your_payment_gateway_api_key_here"
NOTIFICATION_WEBHOOK_URL=""
